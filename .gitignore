# Credentials, sessions and personal settings — never commit
.env
.env.*
!.env.example
*.key
*.pem
cookies*.json
storage-state*.json
auth*.json
.figma-token
**/secrets/

# Local configs that point at private prototypes
examples/**/local.*.mjs
*.local.mjs

# OS / editor
.DS_Store
.idea/
.vscode/
*.log
