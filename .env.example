# Copy to .env (git-ignored). Nothing here is required for the core engine.

# Chrome to drive. Defaults to the macOS install path; any Chromium works.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# The Figma example: a prototype link with "anyone with the link can view".
FIGMA_PROTO_URL=https://www.figma.com/proto/<file-key>/<name>?node-id=<start-node>

# Only for examples/figma-flow/trace-links.mjs (read-only link checks). A Figma personal access token.
FIGMA_TOKEN=
