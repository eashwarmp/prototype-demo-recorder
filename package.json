{
  "name": "prototype-demo-recorder",
  "version": "0.1.0",
  "private": true,
  "description": "Record interactive prototypes (Figma or any web page) as real-time, frame-accurate MP4s with timestamped action logs.",
  "type": "module",
  "bin": { "pdr": "src/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "record": "node src/cli.js record",
    "verify": "node src/cli.js verify"
  },
  "dependencies": {
    "playwright-core": "1.48.2"
  }
}
